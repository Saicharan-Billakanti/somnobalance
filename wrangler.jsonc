{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "somnobalance",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker/index.js",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "cache": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "account_id": "fa3367bd68fc743fc113e65cba64435f",
  "routes": [
    {
      "pattern": "somnobalance.com/*",
      "zone_name": "somnobalance.com"
    },
    {
      "pattern": "www.somnobalance.com/*",
      "zone_name": "somnobalance.com"
    }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "SITE_ACCESS_ENABLED": "true",
    "BREVO_DOI_REDIRECT_URL": "https://somnobalance.com/de",
    "BREVO_DOI_TEMPLATE_ID": "1",
    "BREVO_LIST_ID": "3"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "somnobalance-db",
      "database_id": "44a3b55e-a932-455e-b80d-1f440fb16168"
    }
  ]
}
