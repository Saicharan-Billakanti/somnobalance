# Placeholder reference. For vinext/Cloudflare, copy to .dev.vars (ignored).
# Never use NEXT_PUBLIC_ for these values. Leave blank until securely configured.
RESEND_API_KEY=
MAIL_FROM="SomnoBalance <no-reply@somnobalance.com>"
# Client must approve recipient before live use; expected hello@somnobalance.com.
MAIL_TO=
BREVO_API_KEY=
BREVO_LIST_ID=3
BREVO_DOI_TEMPLATE_ID=1
BREVO_DOI_REDIRECT_URL=https://somnobalance.com/de
# Stripe test keys for local/test mode; configure the same names as Worker secrets in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Generate a random secret of at least 32 characters, used to HMAC abuse identifiers.
ABUSE_HMAC_KEY=

