generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
}

enum PaymentMethod {
  CARD
  SEPA
  PAYPAL
}

model Order {
  id            String         @id @default(cuid())
  createdAt     DateTime       @default(now())
  status        OrderStatus    @default(PENDING_PAYMENT)
  paymentMethod PaymentMethod?

  firstName  String
  lastName   String
  email      String
  street     String
  postalCode String
  city       String
  country    String

  subtotal Float
  shipping Float
  total    Float
  currency String @default("EUR")

  stripeSessionId String? @unique

  items OrderItem[]
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  slug  String
  name  String
  price Float
  qty   Int
}

model ContactMessage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  name    String
  email   String
  topic   String
  message String
}

// B2B wholesale account application — distinct from PartnerApplication
// below. Wholesale pricing, no commission, no discount links. Backend
// team: this table only captures submissions; account creation/approval
// flow (e.g. status transitions, price-list assignment) is not built yet.
model BusinessApplication {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  status    String   @default("pending") // pending | approved | rejected

  contactName   String
  email         String
  phone         String?
  companyName   String
  companyType   String // hotel | planning-office | clinic | other
  propertyCount String?
  projectStage  String // planning | active | renovation | other
  message       String?
}

// Affiliate/referral partner application — distinct from
// BusinessApplication above. Personal referral link with a 5% customer
// discount, up to 10% commission for the partner, never wholesale
// pricing. Backend team: this table only captures submissions; referral
// link generation and commission tracking are not built yet.
model PartnerApplication {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  status    String   @default("pending") // pending | approved | rejected

  contactName            String
  email                  String
  phone                  String?
  profession             String // physiotherapist | alternative-practitioner | kinesiologist | massage-therapist | hotel | other
  practiceOrPropertyName String
  website                String?
  message                String?
}

model User {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
}
